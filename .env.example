# Copy this file to .env.local and fill in the values.
# .env.local is never uploaded to GitHub.

# Key for the Google Gemini API. Create it in Google AI Studio.
# Leave empty to run in demo mode (only the built-in sample labels work).
GEMINI_API_KEY=

# Name of the Gemini model that reads the photo. Model names change over time:
# copy the current fast model with image input from Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
